<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline checks of the KSP-free flare model (no KSP or Unity needed): dotnet run -c Release -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\Source\FlareModel.cs" Link="Source\FlareModel.cs" />
    <Compile Include="..\..\Source\Graybody.cs" Link="Source\Graybody.cs" />
  </ItemGroup>
</Project>
